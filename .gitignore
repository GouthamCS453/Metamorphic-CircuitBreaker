# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Dataset (large raw files only — presets are tracked) ──────────────────────
data/isic2019/
*.zip
*.tar.gz
*.tar
*.h5
*.hdf5

# ── Model checkpoints (large binary files) ────────────────────────────────────
checkpoints/best_model.pth
checkpoints/best_model_*.pth
*.pth
*.pt
*.ckpt

# Allow checkpoint metadata / split CSVs to be tracked
!checkpoints/val_split.csv
!checkpoints/train_split.csv
!checkpoints/training_log.json

# ── Run outputs ───────────────────────────────────────────────────────────────
outputs/

# ── Documents and Exports ─────────────────────────────────────────────────────
*.docx
*.doc
*.html

# Allow Phase 2 methodology markdown to be tracked
!Phase2_Methodology_and_Architecture.md

# ── Testing Suites & Experiments (Ignore all except mcb_portable) ──────────────
mcb_experiments/
new_test/
member_results/
results_v4/
New_Scripts_Ideal/
tests/
test/
random_gradcam.py
run_phase1.py
test_*.py
scripts/test_*.py

# Ensure mcb_portable is explicitly tracked
!mcb_portable/
!mcb_portable/**

# ── PDF Documents (Ignore all PDFs everywhere, including mcb_portable) ─────────
*.pdf
**/*.pdf

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Coverage & testing artifacts ──────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ── Streamlit cache ───────────────────────────────────────────────────────────
.streamlit/

# ── Temporary / one-off scripts (not part of framework) ──────────────────────
scripts/write_readme.py
scripts/generate_pdf.py
scripts/build_ieee_paper.py
scripts/test_latex_to_word.py
scripts/test_layout.py

# ── Diagrams (LaTeX source deleted; ignore stale artefacts) ───────────────────
diagrams/
*.tex
*.aux
*.out
*.fls
*.fdb_latexmk
